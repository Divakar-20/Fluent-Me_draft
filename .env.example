# ====================================================================
# FluentMe Environment Configuration
# ====================================================================

# Port for FluentMe Node.js Backend Server
PORT=5000

# Backend API URL for Vite Frontend
VITE_API_URL=http://localhost:5000/api

# --------------------------------------------------------------------
# Supabase Configuration
# --------------------------------------------------------------------
# Obtain these from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
# https://supabase.com/dashboard/project/_/settings/api

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe for browser usage)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Backend only, optional for administrative bypass)
SUPABASE_SERVICE_ROLE_KEY=
